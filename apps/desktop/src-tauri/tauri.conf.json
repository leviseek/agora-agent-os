{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent OS",
  "version": "0.1.0",
  "identifier": "dev.agentos.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @agentos/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @agentos/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent OS",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Agent OS desktop client",
    "longDescription": "Desktop client for the Agent OS runtime: sessions, chat, task graphs, capabilities, topology and events."
  }
}
